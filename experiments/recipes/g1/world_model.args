# Defaults shared by the world-model learners on packed G1 motions.
agent.wm.imagine_batch=2048
agent.wm.wm_batch_size=2048
env.wm_only_observations=true
agent.collector.total_frames=10000000000
agent.save_interval=5120000
agent.wm.ckpt_light=true
agent.wm.wm_hidden=[1024,1024,1024]
agent.wm.wm_batches_per_iter=5
agent.wm.wm_warmup_iters=0
agent.wm.wm_mirror=0.5
agent.wm.wm_lr=0.0004
agent.wm.wm_opt=muon
agent.wm.min_replay_steps=64
agent.wm.env_steps_per_iter=1.5
agent.wm.gamma=0.97
agent.wm.actor_lr=0.0004
agent.wm.critic_lr=0.0004
agent.wm.critic_hidden=[256,128]
agent.wm.action_noise_std=0.1
agent.wm.actor_ema=0.995
agent.wm.actor_opt=muon
agent.wm.actor_lr_mult=4.0
agent.wm.actor_lr_decay_return=0.75
agent.wm.actor_lr_decay_len=300
agent.wm.actor_lr_decay_by=1400
agent.wm.compile=true
agent.wm.compile_eager=true
agent.wm.elementwise_3x3=true
agent.wm.fused_adam=true
