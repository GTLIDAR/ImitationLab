# ICE profile for the Isaac Lab develop runtime (torch 2.12 / Isaac Sim 6.1). Legacy pair of the ice_develop cluster profile.
# The b2 runtime stays in .env.ice_runtime.
# Stage the exact SIF and manifest on ICE before using this profile.
CLUSTER_JOB_SCHEDULER=SLURM
CLUSTER_LOGIN=ice

CLUSTER_ISAACLAB_DIR=${ICE_PROJECT_ROOT}/isaaclab
CLUSTER_SIF_PATH=${ICE_SHARED_SCRATCH}/isaaclabsif
CLUSTER_SHARED_SIF_PATH=${ICE_SHARED_SCRATCH}/isaaclabsif/isaaclab-runtime-develop-torch2.12-cu130-20261009.sif
CLUSTER_DATA_DIR=${ICE_PROJECT_ROOT}/data
CLUSTER_ISAAC_SIM_CACHE_DIR=${ICE_PROJECT_ROOT}/cache
CLUSTER_JOB_TMPDIR_ROOT=/tmp

CLUSTER_HF_TOKEN_FILE=${ICE_HOME}/.hf_token
CLUSTER_WANDB_API_KEY_FILE=${ICE_HOME}/.wandb_api_key
CLUSTER_AUTO_SETUP_G1_DATA=0
CLUSTER_APPEND_DEFAULT_G1_MANIFEST=0
CLUSTER_G1_MANIFEST_REFRESH_POLICY=never

CLUSTER_PYTHON_EXECUTABLE=scripts/tracking/train.py
CLUSTER_SIM_BACKEND=auto
CLUSTER_CU130_RUNTIME_ROOT=/opt/isaaclab-imitation-runtime-spec/.pixi/envs/container-runtime
CLUSTER_G1_USD_PATH=repo
CLUSTER_USE_OVERLAY=0
CLUSTER_USE_SHARED_SIF=1
CLUSTER_SKIP_SINGULARITY_IMAGE_CHECK=1
CLUSTER_SKIP_CACHE_COPY=1
CLUSTER_ARCHIVE_SYNC=1
# Login shell (bash -l) so ~/.bashrc's local Apptainer PATH entry loads on the
# compute node; ICE's system apptainer is gone, only the user-local unprivileged
# install under ${ICE_USER_INSTALL_ROOT}/apptainer/bin remains.
CLUSTER_REMOTE_LOGIN_SHELL=1
CLUSTER_EXTRA_PYTHONPATH_REL=IsaacLab/source/isaaclab:IsaacLab/source/isaaclab_tasks:IsaacLab/source/isaaclab_assets:IsaacLab/source/isaaclab_rl:IsaacLab/source/isaaclab_mimic:envs/isaaclab:experiments:.

CLUSTER_SLURM_SUBMIT_SCRIPT=pace
CLUSTER_SLURM_GPU_GRES=gpu:h100:1
CLUSTER_SLURM_CPUS_PER_TASK=16
CLUSTER_SLURM_MEM=96G
CLUSTER_SLURM_TIME_LIMIT=15:59:00
CLUSTER_SLURM_JOB_NAME_PREFIX=isaaclab3-runtime
CLUSTER_SLURM_OUTPUT_DIR=logs/slurm
CLUSTER_SLURM_PRINT_JOB_SCRIPT=1

REMOVE_CODE_COPY_AFTER_JOB=false
REMOVE_OVERLAY_AFTER_JOB=true

# PACE project allocation (2 TB, shared with the VIP team). The container only
# binds CLUSTER_DATA_DIR, so a dataset living here is INVISIBLE inside
# Singularity without this explicit bind -- it surfaces as "manifest missing"
# even though the compute node mounts the path (ICE job 5577484, 2026-08-15).
CLUSTER_EXTRA_BIND_PATHS=${ICE_SHARED_ALLOCATION}
